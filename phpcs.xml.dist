<?xml version="1.0"?>
<ruleset name="KVKK Cerez Yoneticisi">
    <description>WordPress kodlama standardı; girinti ajansın diğer eklentileriyle aynı olsun diye 4 boşluk.</description>

    <file>.</file>
    <!-- Test koşucusu WordPress dışında çalışır ve WP fonksiyonlarını taklit eder; dağıtıma girmez. -->
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>*.js</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <config name="minimum_wp_version" value="6.7"/>
    <config name="testVersion" value="7.4-"/>

    <rule ref="WordPress-Extra">
        <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
        <!-- Dosya adları sınıf adıyla değil, ev stiliyle (class-*.php) uyumlu. -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    </rule>
    <rule ref="WordPress-Docs"/>
    <rule ref="PHPCompatibilityWP"/>

    <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>
    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <properties>
            <property name="indent" value="4"/>
            <property name="tabIndent" value="false"/>
        </properties>
    </rule>
    <rule ref="WordPress.Arrays.ArrayIndentation">
        <properties>
            <property name="tabIndent" value="false"/>
        </properties>
    </rule>
    <rule ref="PEAR.Functions.FunctionCallSignature">
        <properties>
            <property name="indent" value="4"/>
        </properties>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="kvkk-cerez"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="kvkkc"/>
            </property>
        </properties>
    </rule>
</ruleset>
